<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Le Sens Giratoire" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Recensement et classement des ronds-points de France.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <header class="entete">
      <div class="entete__identite">
        <%= link_to root_path, class: "entete__titre" do %>
          Le Sens Giratoire<span class="entete__sous-titre">La France tourne en rond</span>
        <% end %>
      </div>
      <nav class="entete__navigation">
        <%= link_to "Carte", root_path %>
        <%= link_to "Palmarès", palmares_path(year: Date.current.year) %>
      </nav>
    </header>

    <% if flash.any? %>
      <div class="notifications">
        <% flash.each do |type, message| %>
          <p class="notification notification--<%= type %>" role="status"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <main class="contenu">
      <%= yield %>
    </main>

    <footer class="pied">
      <p>Données cartographiques © les contributeurs OpenStreetMap, sous licence ODbL.</p>
    </footer>
  </body>
</html>
