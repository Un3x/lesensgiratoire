<% content_for :title, "Palmarès #{@year} — Le Sens Giratoire" %>

<section class="palmares">
  <header class="palmares__entete">
    <p class="palmares__surtitre">Recensement des ronds-points de France</p>
    <h1>Palmarès de l'exercice <%= @year %></h1>
  </header>

  <p class="palmares__exercices">
    <% @years.each do |year| %>
      <% if year == @year %>
        <span aria-current="page">Exercice <%= year %></span>
      <% else %>
        <%= link_to "Exercice #{year}", palmares_path(year: year) %>
      <% end %>
    <% end %>
  </p>

  <% @classements.each do |classement| %>
    <section class="palmares__categorie">
      <h2><%= classement[:titre] %> en <%= @year %></h2>

      <% if classement[:ouvrages].any? %>
        <table class="classement">
          <caption>Classement établi au vu des avis exprimés, arrêté aux vingt premiers.</caption>
          <thead>
            <tr>
              <th scope="col">Rang</th>
              <th scope="col">Ouvrage</th>
              <th scope="col">Commune</th>
              <th scope="col">Département</th>
              <th scope="col"><%= classement[:colonne] %></th>
            </tr>
          </thead>
          <tbody>
            <% precedent = rang = nil %>
            <% classement[:ouvrages].each_with_index do |roundabout, index| %>
              <% rang = index + 1 unless roundabout.avis == precedent %>
              <% precedent = roundabout.avis %>
              <tr>
                <td><%= rang %></td>
                <td><%= link_to roundabout.designation, roundabout %></td>
                <td><%= roundabout.commune.presence || "Non renseignée" %></td>
                <td><%= roundabout.departement.presence || "Non renseigné" %></td>
                <td><%= roundabout.avis %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="etat-vide">Aucun avis de cette nature n'a été exprimé au titre de l'exercice <%= @year %>.</p>
      <% end %>
    </section>
  <% end %>
</section>
